{
  "name": "dlopt-learning-lab",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src/tests",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "format": "prettier --write src e2e scripts/*.ts *.ts *.json index.html",
    "format:check": "prettier --check src e2e scripts/*.ts *.ts *.json index.html",
    "audit": "npm audit --audit-level=low",
    "audit:runtime": "npm audit --omit=dev --audit-level=low"
  },
  "dependencies": {
    "katex": "0.19.1",
    "ml-matrix": "6.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
